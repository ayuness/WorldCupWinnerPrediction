# ============================================================
# macOS
# ============================================================
.DS_Store
.AppleDouble
.LSOverride
._*

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Entornos virtuales
.venv/
venv/
env/
ENV/
.env
.python-version

# Distribución / empaquetado
dist/
build/
*.egg-info/
*.egg

# ============================================================
# Jupyter Notebooks
# ============================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ============================================================
# Data Science — Modelos y outputs generados
# ============================================================
# Modelos entrenados (generados, no deben subirse)
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.model
models/
saved_models/

# Outputs / resultados generados
outputs/
results/
figures/
plots/

# Archivos de profiling
*.prof

# ============================================================
# Datos grandes (descomenta si los CSVs son muy pesados)
# ============================================================
# *.csv
# *.parquet
# *.feather
# data/raw/
# data/processed/

# ============================================================
# IDEs y editores
# ============================================================
# VSCode (se ignoran configs personales, no del proyecto)
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-snippets
.vscode/extensions.json

# PyCharm / IntelliJ
.idea/
*.iml

# Spyder
.spyderproject.cfg
.spyproject/

# ============================================================
# Logs y temporales
# ============================================================
*.log
*.tmp
*.bak
*.swp
*.swo
~$*

# ============================================================
# Variables de entorno y secretos
# ============================================================
.env
.env.*
secrets.json
credentials.json
